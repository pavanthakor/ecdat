# ECDAT fixture: sshd is a GLOBAL config -- there is no per-endpoint block, so
# its findings carry a system-level scope marker rather than a host:port.
Port 22
PermitRootLogin no

# A retired key exchange: SHA-1 based, 1024-bit group.
KexAlgorithms curve25519-sha256,diffie-hellman-group1-sha1
Ciphers chacha20-poly1305@openssh.com,aes128-cbc
MACs hmac-sha2-256,hmac-md5
HostKeyAlgorithms ssh-ed25519,ssh-rsa

# Commented out, and must not fire.
# KexAlgorithms diffie-hellman-group14-sha1
