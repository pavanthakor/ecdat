# ECDAT fixture: a system-wide OpenSSL policy. Global scope, like sshd.
openssl_conf = default_conf

[default_conf]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
MinProtocol = TLSv1.2
CipherString = DEFAULT:@SECLEVEL=2
Groups = X25519MLKEM768:x25519:prime256v1
