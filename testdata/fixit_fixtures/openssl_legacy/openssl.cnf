# fixit fixture: system-wide TLS policy written before the PQC rollout.
# Both directives the openssl-cnf-groups template owns are wrong here:
# MinProtocol admits TLS 1.0, and the group list is entirely classical.
openssl_conf = default_conf

[default_conf]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
MinProtocol = TLSv1
Groups = prime256v1:x25519
